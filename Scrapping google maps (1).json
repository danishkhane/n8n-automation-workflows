    {
      "parameters": {
        "jsCode": "// Apne node ke sahi naam yahan daalein\nconst newData = $('HTTP Request').all(); \nconst existing = $('Get saved leads').all(); \n\nconst existingKeys = new Set();\n\nexisting.forEach(e => {\n  const title = (e.json.title || '').toLowerCase().trim();\n  const phone = (e.json.phone || '').replace(/\\D/g, ''); \n  const website = (e.json.website || '').toLowerCase().trim().replace(/\\/$/, \"\"); \n  \n  if (title) existingKeys.add(title);\n  if (phone) existingKeys.add(phone);\n  if (website) existingKeys.add(website);\n});\n\nconst uniqueResults = newData.filter(item => {\n  const currentTitle = (item.json.title || '').toLowerCase().trim();\n  const currentPhone = (item.json.phone || '').replace(/\\D/g, '');\n  const currentWebsite = (item.json.website || '').toLowerCase().trim().replace(/\\/$/, \"\");\n  \n  const isDuplicate = (currentTitle && existingKeys.has(currentTitle)) || \n                      (currentPhone && existingKeys.has(currentPhone)) ||\n                      (currentWebsite && existingKeys.has(currentWebsite));\n  \n  if (!isDuplicate) {\n    if (currentTitle) existingKeys.add(currentTitle);\n    if (currentPhone) existingKeys.add(currentPhone);\n    if (currentWebsite) existingKeys.add(currentWebsite);\n    return true;\n  }\n  return false;\n});\n\nreturn uniqueResults;"
      },
